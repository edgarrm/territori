APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sin flag Secure en local (HTTP). En producción va en true: ver el bloque
# "production variables" al final del archivo.
SESSION_SECURE_COOKIE=null

# El registro público crea cuentas sin invitación. El default del código es
# true; en una app con datos personales debe ir en false salvo que se quiera
# explícitamente lo contrario.
REGISTRO_PUBLICO=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# =============================================================================
# production variables
# =============================================================================
#
# Todo lo de arriba está orientado a desarrollo. Este bloque es el conjunto
# completo de variables de seguridad para el .env de PRODUCCIÓN: cópialo tal
# cual y descomenta. Están aquí abajo, comentadas, para que copiar este archivo
# a un .env local siga dando un entorno de desarrollo que arranca.
#
# La app maneja datos personales de ciudadanos (LFPDPPP). Ver la auditoría y el
# checklist de despliegue en docs/operaciones.md.
#
# Este bloque crece con cada fase de la remediación de seguridad. Estado: P4.
#
# --- Arranque: la app ABORTA en producción si estas cuatro no están bien -----
# Lo verifica AppServiceProvider::verificarConfiguracionDeProduccion(). Es
# deliberado: la política de contraseñas y prohibitDestructiveCommands cuelgan
# de isProduction(), así que un APP_ENV mal puesto las degradaba en silencio.
#
# APP_ENV=production
# APP_DEBUG=false                   # true expone stack traces con datos internos
# SESSION_SECURE_COOKIE=true        # cookie de sesión solo por HTTPS
# SESSION_ENCRYPT=true              # cifra el payload de sesión en la tabla sessions
# TRUSTED_PROXIES=10.0.0.0/8        # CIDR real del balanceador. Ver §Red y proxies.
#
# --- Identidad de la instancia -----------------------------------------------
# APP_KEY=base64:...                # php artisan key:generate. NUNCA vacía ni en el repo.
#                                   # Cifra telefono/email/domicilio y firma el
#                                   # HMAC de telefono_hash: rotarla exige
#                                   # re-cifrar y recalcular (docs/operaciones.md).
# APP_URL=https://...               # dominio real con HTTPS
# TENANT_DOMAIN=territori.app       # dominio base para resolver campañas por subdominio
#
# --- Sesión y autenticación --------------------------------------------------
# SESSION_SAME_SITE=strict          # 'lax' permite navegación cross-site hacia la app
# SESSION_DRIVER=database
# BCRYPT_ROUNDS=12
# REGISTRO_PUBLICO=false            # el default del código es true: sin esto el
#                                   # auto-registro queda abierto
# PASSKEYS_USER_HANDLE_SECRET=      # secreto propio; si falta cae a APP_KEY y
#                                   # queda atado a su rotación
#
# --- Red y proxies -----------------------------------------------------------
# TRUSTED_PROXIES=10.0.0.0/8        # CIDR real del balanceador. NUNCA '*': con
#                                   # '*' cualquier cliente cuenta como proxy y
#                                   # puede rotar X-Forwarded-For para saltarse
#                                   # el rate limit de login y falsear la IP que
#                                   # queda en la bitácora de accesos. Ya no
#                                   # tiene default: sin esta variable no se
#                                   # confía en ningún proxy y la app no arranca
#                                   # en producción.
#
# La cabecera `Host` la valida TrustHosts (bootstrap/app.php) contra APP_URL y
# TENANT_DOMAIN, incluidos sus subdominios: sin eso, un `Host:` ajeno envenena el
# enlace de reset de contraseña y manda el token al dominio del atacante. Se
# configura solo a partir de esas dos variables — revísalas antes de desplegar.
#
# --- Base de datos -----------------------------------------------------------
# DB_CONNECTION=pgsql               # nunca sqlite en producción
# DB_SSLMODE=require                # 'prefer' acepta en silencio una conexión en
#                                   # claro; nombre y observaciones no van cifrados
# DB_USERNAME=                      # rol dedicado, NO superusuario (no 'postgres')
# DB_PASSWORD=                      # contraseña fuerte, nunca vacía
#
# --- Registro (logs) ---------------------------------------------------------
# LOG_LEVEL=warning                 # 'debug' vuelca parámetros de request con PII
# LOG_CHANNEL=stack
# LOG_STACK=daily                   # 'single' crece sin rotar
# LOG_DAILY_DAYS=14
#
# --- Correo ------------------------------------------------------------------
# MAIL_MAILER=                      # driver real: con 'log' el reset de contraseña
#                                   # y la verificación de email no llegan a nadie
# MAIL_FROM_ADDRESS=                # dominio propio, no hello@example.com
#
# --- Retención de datos personales (LFPDPPP art. 11) -------------------------
# Los aplica `territori:purgar-datos`, programado a diario en routes/console.php.
# Requiere el scheduler corriendo: sin él no se suprime nada y el incumplimiento
# es silencioso (ver docs/operaciones.md).
#
# RETENCION_ELECTORES_CANCELADOS_DIAS=365   # cuánto sobrevive la fila ya scrubbeada
#                                   # de una Cancelación ARCO antes del borrado
#                                   # físico; existe solo para acreditar la baja
# RETENCION_CAMPANA_CERRADA_DIAS=180  # gracia tras pasar el tenant a estado
#                                   # 'cerrada' antes de borrar la PII de sus
#                                   # electores: al cerrar se agota la finalidad
#
# --- Colas -------------------------------------------------------------------
# QUEUE_CONNECTION=redis            # cola persistente + worker para los jobs de cobertura
# REDIS_PASSWORD=                   # nunca sin contraseña si Redis no está aislado
