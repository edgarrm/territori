APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Deja la cookie de sesión sin flag Secure en local (HTTP). Ver bloque de
# producción al final: en prod DEBE ir en true (cookie solo por HTTPS).
SESSION_SECURE_COOKIE=null

# Proxies de confianza. '*' trata a cualquier cliente como proxy: puede rotar
# X-Forwarded-For para saltarse el rate limit de login. Acótalo al CIDR del
# balanceador en producción. Ver docs/operaciones.md.
TRUSTED_PROXIES=*

# --- Obligatorio en PRODUCCIÓN (la app maneja PII, LFPDPPP) ---
# La app ABORTA el arranque en producción si faltan los tres primeros:
# ver AppServiceProvider::verificarConfiguracionDeProduccion().
# APP_ENV=production
# APP_DEBUG=false            # nunca true en prod: expone stack traces con datos internos
# SESSION_SECURE_COOKIE=true # cookie de sesión solo por HTTPS
# SESSION_ENCRYPT=true       # cifra el payload de sesión en reposo
# SESSION_SAME_SITE=strict
# TRUSTED_PROXIES=10.0.0.0/8 # CIDR real del balanceador, nunca '*'
# DB_SSLMODE=require         # 'prefer' acepta en silencio una conexión en claro
# LOG_LEVEL=warning
# LOG_STACK=daily

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
